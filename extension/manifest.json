{
  "manifest_version": 3,
  "name": "Timelog",
  "version": "0.0",
  "description": "Syncs your timelog entries into SuiteProjects Pro timesheets. Never submits.",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": ["nativeMessaging", "sidePanel", "storage"],
  "host_permissions": ["https://*.netsuitesuiteprojectspro.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "action": { "default_title": "Timelog" },
  "content_scripts": [
    {
      "matches": ["https://*.netsuitesuiteprojectspro.com/timesheet.pl*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.netsuitesuiteprojectspro.com/timesheet.pl*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
