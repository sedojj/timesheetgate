{
  "manifest_version": 3,
  "name": "Timesheetgate — Make Minutes Multiply",
  "version": "0.0",
  "description": "Syncs your local timesheet entries (entries.csv) into SuiteProjects Pro timesheets. Never submits.",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*.netsuitesuiteprojectspro.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Timesheetgate — Make Minutes Multiply",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.netsuitesuiteprojectspro.com/timesheet.pl*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.netsuitesuiteprojectspro.com/timesheet.pl*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
